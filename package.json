{
  "name": "the-non-fictional",
  "private": true,
  "version": "2.0.0",
  "description": "Personal essays, reflections, and photography by R\u016bta Tu\u010dkut\u0117",
  "author": "R\u016bta Tu\u010dkut\u0117",
  "license": "0BSD",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:content": "tsx --env-file=.env scripts/migrate-content.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "images:check": "node scripts/optimize-images.cjs --check",
    "images:optimize": "node scripts/optimize-images.cjs",
    "migrate:media": "tsx --env-file=.env scripts/migrate-media.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "sharp": "^0.35.4",
    "shiki": "^1.29.2",
    "tailwind-merge": "^2.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "cross-env": "^7.0.3",
    "gray-matter": "^4.0.3",
    "prettier": "^3.4.2",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.7.3"
  }
}
