# Payload needs a Postgres database. Production uses Neon (neon.tech), which is
# what Vercel's Postgres integration provisions; any Postgres URL works.
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# Signs and verifies admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-me

# Absolute origin, used for canonical URLs, OG tags, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://www.thenonfictional.com

# The address the contacts page links to. There was none in the repository to
# carry over — the old form posted to Netlify Forms — so set this.
NEXT_PUBLIC_CONTACT_EMAIL=hello@thenonfictional.com
